# FinPilot AI Environment Configuration

# Application Config
PROJECT_NAME="FinPilot AI"
TAGLINE="Your Autonomous AI Finance Controller"
VERSION="1.0.0"
API_V1_STR="/api"
JWT_SECRET="finpilot_super_secret_jwt_key_2026_antigravity"

# Supabase Credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-never-expose-to-browser"

# Database
DATABASE_URL="sqlite:///./finpilot.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres"

# AI / LLM Configuration
GROQ_API_KEY="your_groq_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Market & Financial Data Providers
MARKET_PROVIDER="NSE_ENSEMBLE"
MARKET_API_KEY=""
MARKET_API_SECRET=""
NEWS_API_KEY=""

# Cache Layer
REDIS_URL="redis://localhost:6379/0"

# Application Mode
DEMO_MODE="True"